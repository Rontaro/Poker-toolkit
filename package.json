{
  "name": "poker-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "poker": "tsx packages/cli/src/main.ts",
    "ingest": "tsx packages/cli/src/main.ts ingest",
    "watch": "tsx packages/cli/src/main.ts watch",
    "study": "tsx packages/cli/src/main.ts study",
    "report": "tsx packages/cli/src/main.ts report",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File avvia.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
